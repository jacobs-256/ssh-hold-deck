{
  "name": "ssh-hold-deck",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "cargo run --release --manifest-path backend-rust/Cargo.toml",
    "test": "cargo test --locked --manifest-path backend-rust/Cargo.toml && cargo build --locked --manifest-path backend-rust/Cargo.toml && npm run web:prepare && node --test tests/unit/*.test.js tests/rust/*.test.js",
    "web:prepare": "node scripts/prepare-web.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:verify": "node scripts/verify-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "lucide": "^1.64.0",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
